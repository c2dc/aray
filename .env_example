# =============================================================================
# aray — environment configuration template
#
# Copy the relevant lines into `.env` and uncomment/fill them in.
# CLI flags always override these env vars, and env vars override the built-in
# defaults. For batch commands, values in .evaluator or .normalizer also
# override environment variables: CLI > TOML > environment > defaults.
#
# OPENAI_API_KEY is only required for the official OpenAI endpoint (no
# base_url). When a base_url is set (Ollama, LiteLLM, OpenRouter, per-step
# URLs, ...) a placeholder key is injected automatically, so keyless local
# gateways work without any key.
# =============================================================================

# -----------------------------------------------------------------------------
# Credentials & endpoint
# -----------------------------------------------------------------------------

# API key for the OpenAI-compatible endpoint.
# Required only when no base_url is configured (official OpenAI endpoint).
# For local gateways (Ollama, LiteLLM) a placeholder key is auto-injected.
#OPENAI_API_KEY=sk-proj-...

# Base URL for an OpenAI-compatible API gateway (LiteLLM, Ollama, OpenRouter, ...).
# Leave unset to use the official OpenAI API. Overridden by the --base-url flag.
# Acts as the shared default for both steps unless overridden per-step below.
#OPENAI_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Model selection
# -----------------------------------------------------------------------------

# Default model for every LLM node. Overridden by the --model flag.
# Falls back to "gpt-4.1" when unset. Also used as the judge model.
#OPENAI_MODEL=gpt-4.1

# Model for the normalize_rule / judge node only.
# Overrides OPENAI_MODEL for normalization. Overridden by the --normalize-model flag.
#NORMALIZE_MODEL=gpt-4.1

# Model for the extract_strings / extract_constants nodes only.
# Overrides OPENAI_MODEL for extraction. Overridden by the --extract-model flag.
#EXTRACT_MODEL=gpt-4.1

# -----------------------------------------------------------------------------
# Per-step endpoint & credentials (optional)
#
# Point each pipeline step at a DIFFERENT provider. Each falls back to the
# shared value above when unset. Overridden by the matching CLI flags
# (--normalize-base-url / --extract-base-url / --normalize-api-key / --extract-api-key).
# -----------------------------------------------------------------------------

# Base URL for the normalize step only. Overrides OPENAI_BASE_URL for normalization.
#NORMALIZE_BASE_URL=https://api.openai.com/v1

# Base URL for the extract step only. Overrides OPENAI_BASE_URL for extraction.
#EXTRACT_BASE_URL=http://localhost:11434/v1

# API key for the normalize step only. Overrides OPENAI_API_KEY for normalization.
#NORMALIZE_API_KEY=sk-proj-...

# API key for the extract step only. Overrides OPENAI_API_KEY for extraction.
#EXTRACT_API_KEY=sk-dummy-api-key

# Example mixed setup: normalize on OpenAI (strong model), extract on local Ollama.
#NORMALIZE_BASE_URL=https://api.openai.com/v1
#NORMALIZE_API_KEY=sk-proj-...
#NORMALIZE_MODEL=gpt-4.1
#EXTRACT_BASE_URL=http://localhost:11434/v1
#EXTRACT_API_KEY=sk-dummy-api-key
#EXTRACT_MODEL=phi4:14b

# =============================================================================
# Provider examples — pick ONE block and adapt the values above
# =============================================================================

# --- OpenAI (official API) ---------------------------------------------------
#OPENAI_API_KEY=sk-proj-...
#OPENAI_MODEL=gpt-4.1

# --- Ollama (local) ----------------------------------------------------------
#OPENAI_BASE_URL=http://localhost:11434/v1
#OPENAI_MODEL=phi4:14b
#OPENAI_MODEL=qwen3.5:4b
#OPENAI_MODEL=qwen3.5:cloud

# --- LiteLLM (gateway) -------------------------------------------------------
#OPENAI_BASE_URL=http://localhost:4000
#OPENAI_API_KEY=sk-dummy-api-key

# --- OpenRouter --------------------------------------------------------------
#OPENAI_BASE_URL=https://openrouter.ai/api/v1
#OPENAI_API_KEY=sk-or-...
#OPENAI_MODEL=qwen/qwen3.5-flash-02-23
