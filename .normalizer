[normalizer]
# Configuration precedence is:
#   command-line option > this file > environment variable > built-in default
# Values in this file override NORMALIZE_* and OPENAI_* variables loaded from
# the process environment or .env.

# YARA files or directories to process. Directories are walked recursively.
# Positional CLI paths replace this entire list.
directories = [
    "evaluation/yara-repos/rules/cve_rules",
    "evaluation/yara-repos/rules/antidebug_antivm",
    "evaluation/yara-repos/rules/crypto",
    "evaluation/yara-repos/rules/email",
    "evaluation/yara-repos/rules/malware",
    "evaluation/yara-repos/rules/packers",
    "evaluation/yara-repos/rules/exploit_kits",
    "evaluation/yara-repos/rules/webshells",
]

# Normalized rules are written below this root. Directory inputs preserve their
# relative structure; standalone files are written directly below this root.
output_root = "evaluation/normalized-glm-5.2"

# Normalize settings override NORMALIZE_MODEL / NORMALIZE_BASE_URL and then
# OPENAI_MODEL / OPENAI_BASE_URL.
#model = "glm-5.2:cloud"
#base_url = "http://localhost:11434/v1"

# The judge inherits model, base_url, and normalize_api_key when its matching
# option is omitted. Set judge_* to evaluate with a separate provider/model.
#judge_model = "glm-5.2:cloud"
# judge_base_url = "https://api.openai.com/v1"

# Optional credentials override NORMALIZE_API_KEY and OPENAI_API_KEY. Keep real
# secrets out of version control. Keys are never printed or written to reports.
# normalize_api_key = "not-needed"
# judge_api_key = "sk-..."

# Runtime and report controls.
# Run `aray-normalize --config .normalizer` to use this input list without
# positional paths; a completely argument-free invocation only prints CLI help.
# no_stream = false
# workers = 1                    # parallel normalization requests
# output = "norm_report.json"   # default: timestamped evaluation/reports path
